# Outfit ideas and clothing detection use an OpenAI-compatible Chat Completions endpoint.
# For OpenAI, set WARDROBE_LLM_API_KEY. For a local model, set WARDROBE_LLM_BASE_URL
# (for example http://localhost:11434/v1) and WARDROBE_LLM_MODEL; the key may stay blank.
WARDROBE_LLM_API_KEY=
WARDROBE_LLM_BASE_URL=
WARDROBE_LLM_MODEL=gpt-5.4-mini
# Optional: use a vision-capable model for photo imports if different from the stylist model.
WARDROBE_VISION_MODEL=
WARDROBE_STYLIST_MODEL=
# Optional: reasoning effort for outfit suggestions (for example none, low, high), if your provider supports it.
# Outfit picks come from a prebuilt shortlist, so little reasoning is needed; none is much faster.
WARDROBE_REASONING_EFFORT=

# Garment cutouts and modeled photos use the OpenAI Images API only.
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high

# Add a PNG at data/model-reference.png or point to another local file.
WARDROBE_MODEL_REFERENCE=data/model-reference.png
